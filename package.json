{
  "name": "@ruihuahe/dsh-agent-manager",
  "version": "0.1.0",
  "description": "Manage the declared tool policy of DeepSeek Harness agent presets",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hrhgit/dsh-agent-manager.git" },
  "homepage": "https://github.com/hrhgit/dsh-agent-manager#readme",
  "bugs": { "url": "https://github.com/hrhgit/dsh-agent-manager/issues" },
  "keywords": ["deepseek-harness", "dsh", "cordis", "agent", "agent-manager", "tools"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/remote.js" },
    "./typert": { "types": "./lib/types/remote.d.ts", "default": "./lib/remote.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/client.js.map", "lib/remote.js", "lib/types/**/*.d.ts", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": { "zh-CN": "智能体管理器", "en": "Agent Manager" },
      "summary": { "zh-CN": "在智能体预设声明的范围内查看并切换工具。", "en": "View and toggle tools declared by an agent preset." },
      "category": "productivity"
    },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "scripts": {
    "clean": "node scripts/clean-package.mjs",
    "contracts": "tsc -p tsconfig.host.json && tsdown --config tsdown.host.config.ts",
    "typecheck": "pnpm run contracts && tsc -p tsconfig.client.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.host.json && tsdown --config tsdown.host.config.ts && tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.ts && pnpm run check:client",
    "check:client": "node scripts/check-client-bundle.mjs",
    "test": "pnpm run contracts && vitest run",
    "pack:check": "pnpm pack --pack-destination dist",
    "prepare": "pnpm run build"
  },
  "dependencies": { "zod": "^4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "react": ">=18.2.0 <20.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.28",
    "lightningcss": "^1.30.2",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
